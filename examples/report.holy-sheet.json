{
  "fancyTemplate": 1,
  "writer": "holy-sheet",
  "description": "A regional report: one SHEET repeated per region with $each, typed numbers and booleans kept as cells, every string wrapped {value: s} so data can never become a formula, and a sparse summary sheet. Rows repeat with a $value splice (SPEC.md section 8): one row per quarter, each spliced cell encoded exactly as a written one.",
  "variables": {
    "title": { "type": "string", "required": true, "maxLength": 120, "example": "Regional revenue" },
    "generatedAt": { "type": "date", "required": true, "example": "2026-10-27" },
    "regions": {
      "type": "array",
      "required": true,
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "required": true, "maxLength": 31 },
          "comment": { "type": "string", "default": "", "maxLength": 500 },
          "quarters": {
            "type": "array",
            "required": true,
            "maxItems": 4,
            "items": {
              "type": "object",
              "properties": {
                "label": { "type": "string", "required": true, "maxLength": 20 },
                "revenue": { "type": "number", "required": true },
                "target": { "type": "number", "required": true },
                "onTarget": { "type": "boolean", "required": true }
              }
            }
          }
        }
      },
      "example": [{ "name": "EMEA", "comment": "", "quarters": [
        { "label": "Q1", "revenue": 1.2, "target": 1.0, "onTarget": true },
        { "label": "Q2", "revenue": 1.4, "target": 1.5, "onTarget": false },
        { "label": "Q3", "revenue": 2.1, "target": 1.8, "onTarget": true },
        { "label": "Q4", "revenue": 1.9, "target": 2.0, "onTarget": false }
      ] }]
    }
  },
  "document": {
    "sheets": [
      {
        "name": "Summary",
        "cells": {
          "A1": { "value": "{{ title }}" },
          "A2": { "value": "Generated" },
          "B2": "{{ generatedAt }}",
          "A3": { "value": "Generated (text)" },
          "B3": "{{ generatedAt | date:\"d MMMM yyyy\" }}"
        }
      },
      {
        "$each": "regions",
        "$as": "region",
        "name": "{{ region.name }}",
        "columns": [
          { "header": "Quarter" },
          { "header": "Revenue ($M)", "type": "number" },
          { "header": "Target ($M)", "type": "number" },
          { "header": "On target" }
        ],
        "rows": [
          { "$each": "region.quarters", "$as": "q", "$value": ["{{ q.label }}", "{{ q.revenue }}", "{{ q.target }}", "{{ q.onTarget }}"] },
          ["Comment", "{{ region.comment }}", "Sheet {{ $index }}", "{{ $last }}"]
        ]
      }
    ]
  }
}

{
  "writer": "last-word",
  "schema": "last-word 0.x (Doc model shared with fine-print)",
  "notes": "An ALLOWLIST: a string field not matched here refuses tokens. link, chart option, color, font, fonts, page geometry and every style field are deliberately absent. Band slots refuse a value containing {page}/{pages}: last-word writes them as PAGE and NUMPAGES fields with str_replace and has no escape.",
  "fields": [
    { "path": "title", "encode": "text" },
    { "path": "**.runs.*.text", "encode": "text" },
    { "path": "**.blocks.*.text", "encode": "text" },
    { "path": "**.blocks.*.alt", "encode": "text" },
    { "path": "**.blocks.*.src", "encode": "image", "mime": ["image/png", "image/jpeg"] },
    { "path": "page.header.left", "encode": "band" },
    { "path": "page.header.center", "encode": "band" },
    { "path": "page.header.right", "encode": "band" },
    { "path": "page.footer.left", "encode": "band" },
    { "path": "page.footer.center", "encode": "band" },
    { "path": "page.footer.right", "encode": "band" }
  ]
}
